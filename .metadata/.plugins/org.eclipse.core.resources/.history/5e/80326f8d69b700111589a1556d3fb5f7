async function toggleDishAvailability(dishId) {
    try {
        // Direct GET URL for easy testing & execution without Postman
        const res = await fetch(`/api/menu/toggle-availability?id=${dishId}`);
        const data = await res.json();
        if (res.ok) {
            showToast(`${data.name} is now ${data.isAvailable ? 'IN STOCK' : 'SOLD OUT'}`, 'success');
            loadMenuItems();
        } else {
            showToast('Error toggling availability: ' + data.error, 'error');
        }
    } catch (e) {
        showToast('Network error: ' + e.message, 'error');
    }
}

async function quickEditPrice(dishId, currentPrice) {
    const newPriceStr = prompt(`Enter new price for dish ID ${dishId}:`, currentPrice);
    if (!newPriceStr) return;

    const newPrice = parseFloat(newPriceStr);
    if (isNaN(newPrice) || newPrice <= 0) {
        alert("Invalid price entered.");
        return;
    }

    const item = allMenuItems.find(i => i.id === dishId);
    if (!item) return;

    try {
        const res = await fetch(`/api/menu/${dishId}`, {
            method: 'PUT',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({
                ...item,
                price: newPrice
            })
        });

        if (res.ok) {
            showToast(`Updated price to $${newPrice.toFixed(2)}`, 'success');
            loadMenuItems();
        }
    } catch (e) {
        showToast('Error updating price: ' + e.message, 'error');
    }
}

// Add New Dish Modal
function openAddDishModal() {
    document.getElementById('addDishOverlay').classList.add('open');
}

function closeAddDishModal() {
    document.getElementById('addDishOverlay').classList.remove('open');
}

function closeAddDishOnOverlay(e) {
    if (e.target.id === 'addDishOverlay') {
        closeAddDishModal();
    }
}

async function submitNewDish() {
    const name = document.getElementById('newDishName').value.trim();
    const category = document.getElementById('newDishCategory').value;
    const price = parseFloat(document.getElementById('newDishPrice').value);
    const diet = document.getElementById('newDishDiet').value;
    const prepTime = parseInt(document.getElementById('newDishPrepTime').value) || 15;
    const desc = document.getElementById('newDishDesc').value.trim();
    const image = document.getElementById('newDishImage').value.trim() || 'https://images.unsplash.com/photo-1546069901-ba9599a7e63c?w=600';

    if (!name || isNaN(price)) {
        showToast('Please fill in dish name and price.', 'error');
        return;
    }

    try {
        const res = await fetch('/api/menu', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({
                name: name,
                category: category,
                price: price,
                dietaryType: diet,
                prepTimeMinutes: prepTime,
                description: desc || 'Delicious chef specialty prepared fresh to order.',
                imageUrl: image,
                isAvailable: true
            })
        });

        if (res.ok) {
            showToast(`Dish '${name}' created successfully!`, 'success');
            closeAddDishModal();
            loadMenuItems();
        } else {
            showToast('Failed to create dish.', 'error');
        }
    } catch (e) {
        showToast('Error creating dish: ' + e.message, 'error');
    }
}

// -------------------------------------------------------------
// TAB 5: DIRECT URL TEST CENTER (NO POSTMAN)
// -------------------------------------------------------------
async function runDirectUrl(url) {
    const consoleHeader = document.getElementById('consoleUrlHeader');
    const consoleOutput = document.getElementById('jsonConsoleOutput');

    consoleHeader.textContent = `Executing: GET ${url} ...`;
    consoleOutput.textContent = "Sending request directly via URL...";

    const startTime = performance.now();

    try {
        const res = await fetch(url);
        const duration = (performance.now() - startTime).toFixed(1);
        const json = await res.json();

        consoleHeader.textContent = `GET ${url} [HTTP ${res.status}] (${duration} ms)`;
        consoleOutput.textContent = JSON.stringify(json, null, 2);

        // If an update or creation was executed, refresh relevant UI
        if (url.includes('toggle-availability') || url.includes('quick-create')) {
            loadMenuItems();
        } else if (url.includes('orders')) {
            fetchKitchenOrders();
        }

    } catch (e) {
        consoleHeader.textContent = `GET ${url} [ERROR]`;
        consoleOutput.textContent = "Request failed: " + e.message;
    }
}

function clearConsole() {
    document.getElementById('consoleUrlHeader').textContent = "Live API Response Output";
    document.getElementById('jsonConsoleOutput').textContent = "// Click any '⚡ Test on Page' button above to inspect live JSON responses directly in browser!";
}

// -------------------------------------------------------------
// TOAST NOTIFICATIONS
// -------------------------------------------------------------
function showToast(message, type = 'info') {
    const container = document.getElementById('toastContainer');
    if (!container) return;

    const toast = document.createElement('div');
    toast.className = `toast ${type}`;
    const icon = type === 'success' ? '✅' : type === 'error' ? '❌' : 'ℹ️';
    toast.innerHTML = `<span>${icon}</span> <span>${message}</span>`;

    container.appendChild(toast);

    setTimeout(() => {
        toast.style.opacity = '0';
        toast.style.transform = 'translateY(10px)';
        setTimeout(() => toast.remove(), 300);
    }, 4000);
}
