async function loadMenuItems() {
    try {
        const res = await fetch('/api/menu/all');
        allMenuItems = await res.json();
        renderMenuDishes();
        renderInventoryTable();
    } catch (e) {
        console.error("Failed to load menu items:", e);
        document.getElementById('menuDishesGrid').innerHTML = `
            <div style="grid-column: 1/-1; text-align: center; padding: 3rem;">
                <p style="color: var(--danger);">Services are currently connecting to Eureka registry. Please wait a few seconds and refresh.</p>
                <button class="btn-kds-action" onclick="loadMenuItems()" style="margin-top: 1rem; background: var(--primary);">Retry</button>
            </div>
        `;
    }
}

function filterCategory(category) {
    currentCategory = category;
    document.querySelectorAll('.category-pill').forEach(btn => {
        btn.classList.toggle('active', btn.textContent.trim() === category || (category === 'All' && btn.textContent.trim() === 'All Dishes'));
    });
    renderMenuDishes();
}

function handleMenuSearch(keyword) {
    renderMenuDishes(keyword.trim().toLowerCase());
}

function renderMenuDishes(searchQuery = '') {
    const grid = document.getElementById('menuDishesGrid');
    if (!grid) return;

    let filtered = allMenuItems;

    if (currentCategory !== 'All') {
        filtered = filtered.filter(item => item.category === currentCategory);
    }

    if (searchQuery) {
        filtered = filtered.filter(item =>
            item.name.toLowerCase().includes(searchQuery) ||
            item.description.toLowerCase().includes(searchQuery) ||
            item.category.toLowerCase().includes(searchQuery)
        );
    }

    if (filtered.length === 0) {
        grid.innerHTML = `<p style="grid-column: 1/-1; text-align: center; color: var(--text-muted); padding: 2rem;">No menu items found in this section.</p>`;
        return;
    }

    grid.innerHTML = filtered.map(item => {
        const isSoldOut = !item.isAvailable;
        return `
            <div class="dish-card ${isSoldOut ? 'sold-out' : ''}">
                <div class="card-image-wrap">
                    <img src="${item.imageUrl || 'https://images.unsplash.com/photo-1546069901-ba9599a7e63c?w=600'}" alt="${item.name}" loading="lazy">
                    <span class="category-tag">${item.category}</span>
                    ${isSoldOut ? `<span class="sold-out-badge">SOLD OUT</span>` : ''}
                </div>
                <div class="card-body">
                    <div class="card-meta">
                        <span class="diet-pill ${item.dietaryType}">${item.dietaryType}</span>
                        <span class="prep-time">⏱️ ${item.prepTimeMinutes || 15} mins</span>
                    </div>
                    <h3 class="dish-name">${item.name}</h3>
                    <p class="dish-desc">${item.description}</p>
                    <div class="card-footer">
                        <span class="dish-price">$${item.price.toFixed(2)}</span>
                        <button class="btn-add-order" ${isSoldOut ? 'disabled' : ''} onclick="addToCart(${item.id})">
                            ${isSoldOut ? 'Sold Out' : '➕ Add to Order'}
                        </button>
                    </div>
                </div>
            </div>
        `;
    }).join('');
}

