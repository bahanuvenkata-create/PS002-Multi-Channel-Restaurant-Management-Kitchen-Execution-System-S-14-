            <td style="font-family: monospace; color: var(--text-dim);">${item.id}</td>
            <td style="font-weight: 700; color: #fff;">${item.name}</td>
            <td><span class="category-tag" style="position: static;">${item.category}</span></td>
            <td style="color: var(--accent); font-weight: 700;">$${item.price.toFixed(2)}</td>
            <td><span class="diet-pill ${item.dietaryType}">${item.dietaryType}</span></td>
            <td>
                <span style="font-weight: 700; color: ${item.isAvailable ? 'var(--success)' : 'var(--danger)'};">
