:root {
    --bg-dark: #0d0f14;
    --bg-card: #151821;
    --bg-card-hover: #1c212e;
    --bg-surface: #1e2230;
    --border: #282f42;
    --border-glow: rgba(255, 107, 53, 0.25);
    --primary: #ff6b35;
    --primary-hover: #ff8354;
    --primary-glow: rgba(255, 107, 53, 0.35);
    --accent: #f7c59f;
    --success: #10b981;
    --success-bg: rgba(16, 185, 129, 0.15);
    --warning: #f59e0b;
    --warning-bg: rgba(245, 158, 11, 0.15);
    --danger: #ef4444;
    --danger-bg: rgba(239, 68, 68, 0.15);
    --info: #3b82f6;
    --info-bg: rgba(59, 130, 246, 0.15);
    --text-main: #f3f4f6;
    --text-muted: #9ca3af;
    --text-dim: #6b7280;
    --radius-sm: 8px;
    --radius-md: 14px;
    --radius-lg: 20px;
    --shadow-sm: 0 4px 6px -1px rgba(0, 0, 0, 0.3);
    --shadow-lg: 0 20px 25px -5px rgba(0, 0, 0, 0.5), 0 8px 10px -6px rgba(0, 0, 0, 0.5);
    --font-heading: 'Outfit', -apple-system, BlinkMacSystemFont, sans-serif;
    --font-body: 'Plus Jakarta Sans', -apple-system, BlinkMacSystemFont, sans-serif;
}

* {
    box-sizing: border-box;
    margin: 0;
    padding: 0;
}

body {
    background-color: var(--bg-dark);
    color: var(--text-main);
    font-family: var(--font-body);
    min-height: 100vh;
    line-height: 1.5;
    overflow-x: hidden;
}

/* Background Atmosphere Glow */
body::before {
    content: '';
    position: fixed;
    top: -20%;
    left: 20%;
    width: 60vw;
    height: 60vh;
    background: radial-gradient(circle, rgba(255, 107, 53, 0.08) 0%, transparent 70%);
    pointer-events: none;
    z-index: 0;
}

/* App Header */
.app-header {
    background: rgba(21, 24, 33, 0.85);
    backdrop-filter: blur(16px);
    border-bottom: 1px solid var(--border);
    position: sticky;
    top: 0;
    z-index: 100;
    padding: 0.85rem 2rem;
    display: flex;
    justify-content: space-between;
    align-items: center;
}

.brand-section {
    display: flex;
    align-items: center;
    gap: 1rem;
}

.logo-icon {
    width: 44px;
    height: 44px;
    background: linear-gradient(135deg, #ff6b35, #e04b16);
    border-radius: 12px;
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 1.6rem;
    box-shadow: 0 4px 15px var(--primary-glow);
}

.brand-titles h1 {
    font-family: var(--font-heading);
    font-size: 1.35rem;
    font-weight: 700;
    letter-spacing: -0.5px;
    background: linear-gradient(120deg, #fff, #f7c59f);
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
}

.brand-titles .subtitle {
    font-size: 0.75rem;
    color: var(--text-muted);
    font-weight: 500;
}

.header-actions {
    display: flex;
    align-items: center;
    gap: 1.25rem;
}

.system-status-pills {
    display: flex;
    gap: 0.5rem;
}

.status-pill {
    display: flex;
    align-items: center;
    gap: 0.4rem;
    background: var(--bg-surface);
    border: 1px solid var(--border);
    padding: 0.35rem 0.75rem;
    border-radius: 9999px;
    font-size: 0.75rem;
    font-weight: 600;
}

.status-dot {
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background-color: var(--success);
    box-shadow: 0 0 8px var(--success);
    animation: pulse 2s infinite;
}

@keyframes pulse {
    0%, 100% { opacity: 1; transform: scale(1); }
    50% { opacity: 0.5; transform: scale(1.15); }
}

.role-switcher {
    display: flex;
    align-items: center;
    gap: 0.6rem;
    background: rgba(30, 34, 48, 0.6);
    border: 1px solid var(--border);
    padding: 0.3rem 0.6rem;
    border-radius: 9999px;
}

.role-switcher label {
    font-size: 0.75rem;
    color: var(--text-muted);
    text-transform: uppercase;
    font-weight: 600;
    letter-spacing: 0.5px;
}

.role-select {
    background: var(--bg-card);
    color: var(--accent);
    border: 1px solid var(--border);
    border-radius: 6px;
    padding: 0.3rem 0.6rem;
    font-size: 0.8rem;
    font-weight: 600;
    outline: none;
    cursor: pointer;
}

/* Nav Tabs */
.nav-tabs-bar {
    background: var(--bg-card);
    border-bottom: 1px solid var(--border);
    padding: 0.5rem 2rem 0;
    display: flex;
    gap: 1rem;
    overflow-x: auto;
}

.nav-tab-btn {
    background: transparent;
    border: none;
    color: var(--text-muted);
    font-family: var(--font-heading);
    font-size: 0.95rem;
    font-weight: 600;
    padding: 0.8rem 1.25rem;
    border-bottom: 3px solid transparent;
    cursor: pointer;
    display: flex;
    align-items: center;
    gap: 0.6rem;
    transition: all 0.2s ease;
    white-space: nowrap;
}

.nav-tab-btn:hover {
    color: var(--text-main);
    background: rgba(255, 255, 255, 0.02);
}

.nav-tab-btn.active {
    color: var(--primary);
    border-bottom-color: var(--primary);
}

.tab-badge {
    background: var(--primary);
    color: #fff;
    font-size: 0.7rem;
    padding: 0.15rem 0.45rem;
    border-radius: 9999px;
    font-weight: 700;
}

/* Main Container */
.main-content {
    max-width: 1400px;
    margin: 0 auto;
    padding: 2rem;
    position: relative;
    z-index: 1;
}

.tab-pane {
    display: none;
    animation: fadeIn 0.3s cubic-bezier(0.16, 1, 0.3, 1);
}

.tab-pane.active {
    display: block;
}

@keyframes fadeIn {
    from { opacity: 0; transform: translateY(8px); }
    to { opacity: 1; transform: translateY(0); }
}

/* Section Header */
.section-banner {
    display: flex;
    justify-content: space-between;
    align-items: flex-end;
    margin-bottom: 2rem;
    border-bottom: 1px solid var(--border);
    padding-bottom: 1.25rem;
    flex-wrap: wrap;
    gap: 1rem;
}

.section-banner h2 {
    font-family: var(--font-heading);
    font-size: 1.75rem;
    font-weight: 700;
    color: #fff;
}

.section-banner p {
    color: var(--text-muted);
    font-size: 0.9rem;
    margin-top: 0.25rem;
}

/* Digital Menu Controls */
.menu-controls {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 1.75rem;
    flex-wrap: wrap;
    gap: 1rem;
}

.category-pills {
    display: flex;
    gap: 0.5rem;
    flex-wrap: wrap;
}

.category-pill {
    background: var(--bg-card);
    border: 1px solid var(--border);
    color: var(--text-muted);
    padding: 0.5rem 1rem;
    border-radius: 9999px;
    font-size: 0.85rem;
    font-weight: 600;
    cursor: pointer;
    transition: all 0.2s ease;
}

.category-pill:hover, .category-pill.active {
    background: var(--primary);
    color: #fff;
    border-color: var(--primary);
    box-shadow: 0 2px 10px var(--primary-glow);
}

.search-box {
    display: flex;
    align-items: center;
    background: var(--bg-card);
    border: 1px solid var(--border);
    border-radius: var(--radius-sm);
    padding: 0.4rem 0.8rem;
    gap: 0.5rem;
}

.search-box input {
    background: transparent;
    border: none;
    color: var(--text-main);
    font-size: 0.85rem;
    outline: none;
    width: 200px;
}

/* Menu Grid */
.menu-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(290px, 1fr));
    gap: 1.5rem;
}

.dish-card {
    background: var(--bg-card);
    border: 1px solid var(--border);
    border-radius: var(--radius-md);
    overflow: hidden;
    display: flex;
    flex-direction: column;
    transition: transform 0.25s ease, border-color 0.25s ease, box-shadow 0.25s ease;
    position: relative;
}

.dish-card:hover {
    transform: translateY(-4px);
    border-color: var(--border-glow);
    box-shadow: var(--shadow-lg);
}

.dish-card.sold-out {
    opacity: 0.75;
    filter: grayscale(0.2);
}

.card-image-wrap {
    height: 180px;
    position: relative;
    overflow: hidden;
    background: #111;
}

.card-image-wrap img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.4s ease;
}

.dish-card:hover .card-image-wrap img {
    transform: scale(1.06);
}

.sold-out-badge {
    position: absolute;
    top: 12px;
    right: 12px;
    background: #dc2626;
    color: #fff;
    font-size: 0.75rem;
    font-weight: 800;
    padding: 0.3rem 0.75rem;
    border-radius: 6px;
    text-transform: uppercase;
    letter-spacing: 0.5px;
    box-shadow: 0 4px 10px rgba(220, 38, 38, 0.4);
    z-index: 2;
}

.category-tag {
    position: absolute;
    top: 12px;
    left: 12px;
    background: rgba(15, 17, 23, 0.8);
    backdrop-filter: blur(8px);
    color: var(--accent);
    font-size: 0.75rem;
    font-weight: 600;
    padding: 0.25rem 0.6rem;
    border-radius: 6px;
    border: 1px solid rgba(255, 255, 255, 0.1);
}

.card-body {
    padding: 1.25rem;
    display: flex;
    flex-direction: column;
    flex-grow: 1;
}

.card-meta {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 0.5rem;
}

.diet-pill {
    font-size: 0.7rem;
    font-weight: 700;
    padding: 0.15rem 0.45rem;
    border-radius: 4px;
}

.diet-pill.Veg { background: rgba(16, 185, 129, 0.2); color: #10b981; }
.diet-pill.Non-Veg { background: rgba(239, 68, 68, 0.2); color: #ef4444; }
.diet-pill.Vegan { background: rgba(59, 130, 246, 0.2); color: #3b82f6; }

.prep-time {
    font-size: 0.75rem;
    color: var(--text-muted);
}

.dish-name {
    font-family: var(--font-heading);
    font-size: 1.15rem;
    font-weight: 700;
    color: #fff;
    margin-bottom: 0.4rem;
}

.dish-desc {
    color: var(--text-muted);
    font-size: 0.825rem;
    line-height: 1.4;
    margin-bottom: 1rem;
    flex-grow: 1;
}

.card-footer {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding-top: 0.75rem;
    border-top: 1px solid rgba(255, 255, 255, 0.06);
}

.dish-price {
    font-family: var(--font-heading);
    font-size: 1.25rem;
    font-weight: 700;
    color: var(--accent);
}

.btn-add-order {
    background: var(--primary);
    color: #fff;
    border: none;
    padding: 0.5rem 1rem;
    border-radius: var(--radius-sm);
    font-size: 0.85rem;
    font-weight: 600;
    cursor: pointer;
    display: flex;
    align-items: center;
    gap: 0.4rem;
    transition: background 0.2s ease, transform 0.15s ease;
}

.btn-add-order:hover:not(:disabled) {
    background: var(--primary-hover);
    transform: translateY(-2px);
}

.btn-add-order:disabled {
    background: #374151;
    color: #9ca3af;
    cursor: not-allowed;
}

/* Floating Cart Drawer */
.cart-floating-button {
    position: fixed;
    bottom: 2rem;
    right: 2rem;
    background: linear-gradient(135deg, #ff6b35, #e04b16);
    color: #fff;
    border: none;
    padding: 0.9rem 1.6rem;
    border-radius: 9999px;
    font-family: var(--font-heading);
    font-size: 1rem;
    font-weight: 700;
    box-shadow: 0 10px 25px var(--primary-glow);
    cursor: pointer;
    display: flex;
    align-items: center;
    gap: 0.75rem;
    z-index: 90;
    transition: transform 0.2s ease, box-shadow 0.2s ease;
}

.cart-floating-button:hover {
    transform: scale(1.05);
    box-shadow: 0 14px 30px rgba(255, 107, 53, 0.5);
}

.cart-modal-overlay {
    position: fixed;
    top: 0;
    left: 0;
    right: 0;
    bottom: 0;
    background: rgba(0, 0, 0, 0.75);
    backdrop-filter: blur(8px);
    z-index: 1000;
    display: none;
    justify-content: flex-end;
}

.cart-modal-overlay.open {
    display: flex;
}

.cart-drawer {
    width: 440px;
    max-width: 100vw;
    height: 100%;
    background: var(--bg-card);
    border-left: 1px solid var(--border);
    display: flex;
    flex-direction: column;
    box-shadow: var(--shadow-lg);
    animation: slideInRight 0.3s ease;
}

@keyframes slideInRight {
    from { transform: translateX(100%); }
    to { transform: translateX(0); }
}

.cart-drawer-header {
    padding: 1.25rem 1.5rem;
    border-bottom: 1px solid var(--border);
    display: flex;
    justify-content: space-between;
    align-items: center;
}

.cart-drawer-header h3 {
    font-family: var(--font-heading);
    font-size: 1.25rem;
    font-weight: 700;
}

.close-btn {
    background: transparent;
    border: none;
    color: var(--text-muted);
    font-size: 1.5rem;
    cursor: pointer;
}

.cart-drawer-body {
    padding: 1.25rem 1.5rem;
    overflow-y: auto;
    flex-grow: 1;
    display: flex;
    flex-direction: column;
    gap: 1.25rem;
}

/* Multi-Channel Selector */
.channel-selector {
    background: var(--bg-surface);
    border: 1px solid var(--border);
    border-radius: var(--radius-sm);
    padding: 0.3rem;
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 0.3rem;
}

.channel-btn {
    background: transparent;
    border: none;
    color: var(--text-muted);
    font-size: 0.8rem;
    font-weight: 600;
    padding: 0.6rem 0.4rem;
    border-radius: 6px;
    cursor: pointer;
    transition: all 0.2s ease;
    text-align: center;
}

.channel-btn.active {
    background: var(--primary);
    color: #fff;
    box-shadow: 0 2px 6px var(--primary-glow);
}

.channel-details-form {
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
}

.form-group label {
    display: block;
    font-size: 0.75rem;
    font-weight: 600;
    color: var(--text-muted);
    margin-bottom: 0.3rem;
    text-transform: uppercase;
}

.form-control {
    width: 100%;
    background: var(--bg-surface);
    border: 1px solid var(--border);
    border-radius: var(--radius-sm);
    padding: 0.6rem 0.8rem;
    color: var(--text-main);
    font-size: 0.85rem;
    outline: none;
}

.form-control:focus {
    border-color: var(--primary);
}

/* Cart Items List */
.cart-items-list {
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
    max-height: 220px;
    overflow-y: auto;
}

.cart-item-row {
    background: var(--bg-surface);
    border: 1px solid var(--border);
    border-radius: var(--radius-sm);
    padding: 0.75rem;
    display: flex;
    justify-content: space-between;
    align-items: center;
}

.cart-item-info h4 {
    font-size: 0.9rem;
    font-weight: 600;
}

.cart-item-info span {
    font-size: 0.8rem;
    color: var(--accent);
}

.qty-controls {
    display: flex;
    align-items: center;
    gap: 0.5rem;
}

.qty-btn {
    width: 26px;
    height: 26px;
    border-radius: 6px;
    border: 1px solid var(--border);
    background: var(--bg-card);
    color: #fff;
    font-weight: bold;
    cursor: pointer;
    display: flex;
    align-items: center;
    justify-content: center;
}

.cart-drawer-footer {
    padding: 1.25rem 1.5rem;
    border-top: 1px solid var(--border);
    background: rgba(21, 24, 33, 0.95);
}

.bill-row {
    display: flex;
    justify-content: space-between;
    font-size: 0.85rem;
    color: var(--text-muted);
    margin-bottom: 0.4rem;
}

.bill-row.total {
    font-size: 1.15rem;
    font-weight: 700;
    color: #fff;
    border-top: 1px dashed var(--border);
    padding-top: 0.6rem;
    margin-top: 0.6rem;
}

.btn-checkout {
    width: 100%;
    margin-top: 1rem;
    background: linear-gradient(135deg, #ff6b35, #e04b16);
    color: #fff;
    border: none;
    padding: 0.85rem;
    border-radius: var(--radius-sm);
    font-family: var(--font-heading);
    font-size: 1rem;
    font-weight: 700;
    cursor: pointer;
    box-shadow: 0 4px 15px var(--primary-glow);
    transition: transform 0.2s ease;
}

.btn-checkout:hover {
    transform: translateY(-2px);
}

/* Kitchen Execution Board (KDS) */
.kds-stats-row {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(180px, 1fr));
    gap: 1rem;
    margin-bottom: 2rem;
}

.stat-card {
    background: var(--bg-card);
    border: 1px solid var(--border);
    border-radius: var(--radius-md);
    padding: 1.25rem;
    display: flex;
    align-items: center;
    gap: 1rem;
}

.stat-icon {
    width: 48px;
    height: 48px;
    border-radius: 12px;
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 1.5rem;
}

.stat-icon.placed { background: var(--info-bg); color: var(--info); }
.stat-icon.prep { background: var(--warning-bg); color: var(--warning); }
.stat-icon.ready { background: var(--success-bg); color: var(--success); }
.stat-icon.total { background: rgba(255, 107, 53, 0.15); color: var(--primary); }

.stat-data h3 {
    font-size: 1.6rem;
    font-family: var(--font-heading);
    font-weight: 700;
}

.stat-data p {
    font-size: 0.75rem;
    color: var(--text-muted);
    text-transform: uppercase;
    font-weight: 600;
}

/* KDS Columns */
.kds-columns {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(320px, 1fr));
    gap: 1.5rem;
}

.kds-column {
    background: rgba(21, 24, 33, 0.6);
    border: 1px solid var(--border);
    border-radius: var(--radius-md);
    padding: 1.25rem;
    display: flex;
    flex-direction: column;
    gap: 1rem;
}

.kds-col-header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding-bottom: 0.75rem;
    border-bottom: 1px solid var(--border);
}

.kds-col-title {
    font-family: var(--font-heading);
    font-size: 1rem;
    font-weight: 700;
    display: flex;
    align-items: center;
    gap: 0.5rem;
}

.kds-count-badge {
    background: var(--bg-surface);
    border: 1px solid var(--border);
    padding: 0.2rem 0.5rem;
    border-radius: 9999px;
    font-size: 0.75rem;
    font-weight: 700;
}

.kds-cards-container {
    display: flex;
    flex-direction: column;
    gap: 1rem;
    min-height: 200px;
}

.kds-order-card {
    background: var(--bg-card);
    border: 1px solid var(--border);
    border-left: 4px solid var(--primary);
    border-radius: var(--radius-sm);
    padding: 1rem;
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
    box-shadow: var(--shadow-sm);
    transition: transform 0.2s ease;
}

.kds-order-card:hover {
    transform: translateY(-2px);
}

.kds-order-card.PLACED { border-left-color: var(--info); }
.kds-order-card.PREPARING { border-left-color: var(--warning); }
.kds-order-card.READY_FOR_PICKUP { border-left-color: var(--success); }

.kds-card-top {
    display: flex;
    justify-content: space-between;
    align-items: center;
}

.kds-order-num {
    font-family: var(--font-heading);
    font-size: 1.1rem;
    font-weight: 700;
    color: #fff;
}

.kds-channel-badge {
    font-size: 0.7rem;
    font-weight: 700;
    padding: 0.2rem 0.5rem;
    border-radius: 4px;
    background: var(--bg-surface);
    color: var(--accent);
    border: 1px solid var(--border);
}

.kds-customer-row {
    font-size: 0.8rem;
    color: var(--text-muted);
}

.kds-items-box {
    background: var(--bg-surface);
    border-radius: 6px;
    padding: 0.6rem;
    display: flex;
    flex-direction: column;
    gap: 0.4rem;
}

.kds-dish-item {
    display: flex;
    justify-content: space-between;
    font-size: 0.85rem;
    font-weight: 600;
}

.kds-card-footer {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-top: 0.25rem;
}

.kds-time {
    font-size: 0.75rem;
    color: var(--text-dim);
}

.btn-kds-action {
    background: var(--bg-surface);
    color: #fff;
    border: 1px solid var(--border);
    padding: 0.45rem 0.9rem;
    border-radius: 6px;
    font-size: 0.8rem;
    font-weight: 700;
    cursor: pointer;
    transition: all 0.2s ease;
}

.btn-kds-action:hover {
    background: var(--primary);
    border-color: var(--primary);
}

/* Live Order Tracker */
.tracker-wrapper {
    background: var(--bg-card);
    border: 1px solid var(--border);
    border-radius: var(--radius-lg);
    padding: 2.5rem;
    max-width: 900px;
    margin: 0 auto;
    box-shadow: var(--shadow-lg);
}

.tracker-search {
    display: flex;
    gap: 1rem;
    margin-bottom: 2.5rem;
}

.tracker-search input {
    flex-grow: 1;
    background: var(--bg-surface);
    border: 1px solid var(--border);
    border-radius: var(--radius-sm);
    padding: 0.8rem 1.25rem;
    color: #fff;
    font-size: 1rem;
    font-family: var(--font-heading);
}

.tracker-search button {
    background: var(--primary);
    color: #fff;
    border: none;
    padding: 0 1.75rem;
    border-radius: var(--radius-sm);
    font-weight: 700;
    cursor: pointer;
}

/* Stepper */
.stepper-container {
    display: flex;
    justify-content: space-between;
    position: relative;
    margin: 3rem 0 2rem;
}

.stepper-container::before {
    content: '';
    position: absolute;
    top: 24px;
    left: 40px;
    right: 40px;
    height: 4px;
    background: var(--bg-surface);
    z-index: 0;
}

.stepper-progress-bar {
    position: absolute;
    top: 24px;
    left: 40px;
    height: 4px;
    background: linear-gradient(90deg, #ff6b35, #10b981);
    z-index: 1;
    transition: width 0.5s ease;
}

.step-node {
    display: flex;
    flex-direction: column;
    align-items: center;
    position: relative;
    z-index: 2;
    width: 90px;
}

.step-circle {
    width: 50px;
    height: 50px;
    border-radius: 50%;
    background: var(--bg-surface);
    border: 3px solid var(--border);
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 1.25rem;
    margin-bottom: 0.75rem;
    transition: all 0.3s ease;
}

.step-node.completed .step-circle {
    background: var(--success);
    border-color: var(--success);
    color: #fff;
    box-shadow: 0 0 15px rgba(16, 185, 129, 0.4);
}

.step-node.active .step-circle {
    background: var(--primary);
    border-color: var(--primary);
    color: #fff;
    box-shadow: 0 0 15px var(--primary-glow);
    animation: bounce 1.5s infinite alternate;
}

@keyframes bounce {
    from { transform: translateY(0); }
    to { transform: translateY(-6px); }
}

.step-label {
    font-size: 0.75rem;
    font-weight: 700;
    color: var(--text-muted);
    text-align: center;
}

.step-node.active .step-label {
    color: var(--primary);
}

.step-node.completed .step-label {
    color: #fff;
}

.tracker-details-card {
    background: var(--bg-surface);
    border: 1px solid var(--border);
    border-radius: var(--radius-md);
    padding: 1.5rem;
    margin-top: 2rem;
    display: flex;
    flex-direction: column;
    gap: 1rem;
}

/* Direct URL Test Center */
.test-center-container {
    display: flex;
    flex-direction: column;
    gap: 2rem;
}

.test-center-notice {
    background: linear-gradient(135deg, rgba(255, 107, 53, 0.1), rgba(59, 130, 246, 0.1));
    border: 1px solid var(--border-glow);
    border-radius: var(--radius-md);
    padding: 1.25rem 1.5rem;
    display: flex;
    justify-content: space-between;
    align-items: center;
    flex-wrap: wrap;
    gap: 1rem;
}

.test-center-notice h3 {
    font-family: var(--font-heading);
    font-size: 1.15rem;
    color: #fff;
    margin-bottom: 0.25rem;
}

.test-center-notice p {
    font-size: 0.85rem;
    color: var(--text-muted);
}

.api-groups-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(420px, 1fr));
    gap: 1.5rem;
}

.api-group-card {
    background: var(--bg-card);
    border: 1px solid var(--border);
    border-radius: var(--radius-md);
    padding: 1.5rem;
    display: flex;
    flex-direction: column;
    gap: 1rem;
}

.api-group-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    border-bottom: 1px solid var(--border);
    padding-bottom: 0.75rem;
}

.api-group-header h4 {
    font-family: var(--font-heading);
    font-size: 1.1rem;
    font-weight: 700;
    color: #fff;
    display: flex;
    align-items: center;
    gap: 0.5rem;
}

.api-endpoint-item {
    background: var(--bg-surface);
    border: 1px solid var(--border);
    border-radius: var(--radius-sm);
    padding: 0.85rem;
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
}

.endpoint-meta {
    display: flex;
    justify-content: space-between;
    align-items: center;
}

.http-method {
    font-size: 0.7rem;
    font-weight: 800;
    padding: 0.15rem 0.5rem;
    border-radius: 4px;
}

.http-method.GET { background: rgba(16, 185, 129, 0.2); color: #10b981; }
.http-method.POST { background: rgba(59, 130, 246, 0.2); color: #3b82f6; }
.http-method.PUT { background: rgba(245, 158, 11, 0.2); color: #f59e0b; }
.http-method.DELETE { background: rgba(239, 68, 68, 0.2); color: #ef4444; }

.endpoint-url-code {
    font-family: 'Consolas', 'Courier New', monospace;
    font-size: 0.825rem;
    color: var(--accent);
    word-break: break-all;
}

.endpoint-actions {
    display: flex;
    gap: 0.5rem;
    margin-top: 0.25rem;
}

.btn-open-url {
    background: transparent;
    border: 1px solid var(--border);
    color: var(--text-muted);
    font-size: 0.75rem;
    padding: 0.3rem 0.6rem;
    border-radius: 4px;
    text-decoration: none;
    cursor: pointer;
    transition: all 0.2s ease;
    display: flex;
    align-items: center;
    gap: 0.3rem;
}

.btn-open-url:hover {
    color: #fff;
    border-color: var(--primary);
    background: rgba(255, 107, 53, 0.1);
}

.btn-run-endpoint {
    background: var(--bg-card);
    border: 1px solid var(--primary);
    color: var(--primary);
    font-size: 0.75rem;
    font-weight: 700;
    padding: 0.3rem 0.6rem;
    border-radius: 4px;
    cursor: pointer;
    transition: all 0.2s ease;
}

.btn-run-endpoint:hover {
    background: var(--primary);
    color: #fff;
}

/* In-Page JSON Response Console */
.json-console-section {
    background: #0b0d13;
    border: 1px solid var(--border);
    border-radius: var(--radius-md);
    overflow: hidden;
    margin-top: 1.5rem;
}

.json-console-header {
    background: #141721;
    padding: 0.75rem 1.25rem;
    border-bottom: 1px solid var(--border);
    display: flex;
    justify-content: space-between;
    align-items: center;
}

.json-console-header span {
    font-size: 0.8rem;
    font-weight: 700;
    color: var(--text-muted);
    text-transform: uppercase;
}

.json-response-display {
    padding: 1.25rem;
    font-family: 'Consolas', 'Courier New', monospace;
    font-size: 0.85rem;
    color: #38bdf8;
    max-height: 380px;
    overflow-y: auto;
    white-space: pre-wrap;
    line-height: 1.5;
}

/* Menu Inventory Management Table */
.inventory-table-wrap {
    background: var(--bg-card);
    border: 1px solid var(--border);
    border-radius: var(--radius-md);
    overflow: hidden;
}

.inventory-table {
    width: 100%;
    border-collapse: collapse;
    text-align: left;
}

.inventory-table th {
    background: var(--bg-surface);
    padding: 1rem 1.25rem;
    font-size: 0.75rem;
    text-transform: uppercase;
    font-weight: 700;
    color: var(--text-muted);
    border-bottom: 1px solid var(--border);
}

.inventory-table td {
    padding: 1rem 1.25rem;
    border-bottom: 1px solid rgba(255, 255, 255, 0.05);
    font-size: 0.85rem;
}

.switch {
    position: relative;
    display: inline-block;
    width: 44px;
    height: 24px;
}

.switch input { opacity: 0; width: 0; height: 0; }

.slider {
    position: absolute;
    cursor: pointer;
    top: 0; left: 0; right: 0; bottom: 0;
    background-color: #ef4444;
    transition: .3s;
    border-radius: 24px;
}

.slider:before {
    position: absolute;
    content: "";
    height: 18px;
    width: 18px;
    left: 3px;
    bottom: 3px;
    background-color: white;
    transition: .3s;
    border-radius: 50%;
}

input:checked + .slider {
    background-color: #10b981;
}

input:checked + .slider:before {
    transform: translateX(20px);
}

/* Service Discovery Status Grid */
.eureka-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(260px, 1fr));
    gap: 1.25rem;
}

.service-card {
    background: var(--bg-card);
    border: 1px solid var(--border);
    border-radius: var(--radius-md);
    padding: 1.25rem;
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
}

.service-card-top {
    display: flex;
    justify-content: space-between;
    align-items: center;
}

.service-name {
    font-family: var(--font-heading);
    font-size: 1.1rem;
    font-weight: 700;
    color: #fff;
}

.service-port {
    font-family: monospace;
    font-size: 0.8rem;
    color: var(--accent);
}

/* Toast Notifications */
.toast-container {
    position: fixed;
    bottom: 2rem;
    left: 2rem;
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
    z-index: 2000;
}

.toast {
    background: var(--bg-card);
    border: 1px solid var(--border);
    padding: 0.75rem 1.25rem;
    border-radius: var(--radius-sm);
    font-size: 0.85rem;
    display: flex;
    align-items: center;
    gap: 0.6rem;
    box-shadow: var(--shadow-lg);
    animation: slideUp 0.3s ease;
}

.toast.success { border-color: var(--success); }
.toast.error { border-color: var(--danger); }

@keyframes slideUp {
    from { transform: translateY(20px); opacity: 0; }
    to { transform: translateY(0); opacity: 1; }
}
