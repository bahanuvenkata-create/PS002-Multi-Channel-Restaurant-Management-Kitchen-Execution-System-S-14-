// ─── AUTH STATE ────────────────────────────────────────────────
let currentUser = null;   // { name, email, role, token }

// Initialize: just load menu; no auto-login anymore
document.addEventListener('DOMContentLoaded', () => {
    loadMenuItems();
    fetchKitchenOrders();
    setInterval(fetchKitchenOrders, 10000);
