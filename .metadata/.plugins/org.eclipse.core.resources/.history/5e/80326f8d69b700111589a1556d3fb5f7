// CART & MULTI-CHANNEL CHECKOUT
// -------------------------------------------------------------
function selectChannel(channel) {
    selectedChannel = channel;
    document.querySelectorAll('.channel-btn').forEach(btn => btn.classList.remove('active'));

    const groupTable = document.getElementById('groupTableNum');
    const groupAddress = document.getElementById('groupAddress');
    const groupPhone = document.getElementById('groupPhone');

    if (channel === 'DINE_IN') {
        document.getElementById('btnChannelDineIn').classList.add('active');
        groupTable.style.display = 'block';
        groupAddress.style.display = 'none';
        groupPhone.style.display = 'none';
    } else if (channel === 'TAKEAWAY') {
        document.getElementById('btnChannelTakeaway').classList.add('active');
        groupTable.style.display = 'none';
        groupAddress.style.display = 'none';
        groupPhone.style.display = 'block';
    } else if (channel === 'DELIVERY') {
        document.getElementById('btnChannelDelivery').classList.add('active');
        groupTable.style.display = 'none';
        groupAddress.style.display = 'block';
        groupPhone.style.display = 'block';
    }
}

function addToCart(dishId) {
    const item = allMenuItems.find(i => i.id === dishId);
    if (!item) return;

    if (!item.isAvailable) {
        showToast(`Cannot add '${item.name}' - Dish is Sold Out!`, 'error');
        return;
    }

    const existing = cart.find(c => c.id === dishId);
    if (existing) {
        existing.quantity += 1;
    } else {
        cart.push({
            id: item.id,
            name: item.name,
            category: item.category,
            price: item.price,
            quantity: 1
        });
    }

    updateCartUI();
    showToast(`Added '${item.name}' to order`, 'success');
}

function updateQty(dishId, delta) {
    const existing = cart.find(c => c.id === dishId);
    if (!existing) return;

    existing.quantity += delta;
    if (existing.quantity <= 0) {
        cart = cart.filter(c => c.id !== dishId);
    }
    updateCartUI();
}

function updateCartUI() {
    const totalQty = cart.reduce((sum, item) => sum + item.quantity, 0);
    const subtotal = cart.reduce((sum, item) => sum + (item.price * item.quantity), 0);
    const tax = subtotal * 0.05;
    const total = subtotal + tax;

    document.getElementById('cartCountBadge').textContent = totalQty;
    document.getElementById('cartTotalBadge').textContent = `$${total.toFixed(2)}`;

    document.getElementById('billSubtotal').textContent = `$${subtotal.toFixed(2)}`;
    document.getElementById('billTax').textContent = `$${tax.toFixed(2)}`;
    document.getElementById('billTotal').textContent = `$${total.toFixed(2)}`;

    const cartList = document.getElementById('cartItemsList');
    if (cart.length === 0) {
        cartList.innerHTML = `<p style="font-size: 0.85rem; color: var(--text-muted); text-align: center; padding: 2rem 0;">Your order is currently empty. Browse the menu to add dishes!</p>`;
        return;
    }

    cartList.innerHTML = cart.map(item => `
        <div class="cart-item-row">
            <div class="cart-item-info">
                <h4>${item.name}</h4>
                <span>$${item.price.toFixed(2)} &times; ${item.quantity} = $${(item.price * item.quantity).toFixed(2)}</span>
            </div>
            <div class="qty-controls">
                <button class="qty-btn" onclick="updateQty(${item.id}, -1)">-</button>
                <span style="font-weight: 700; min-width: 20px; text-align: center;">${item.quantity}</span>
                <button class="qty-btn" onclick="updateQty(${item.id}, 1)">+</button>
            </div>
        </div>
    `).join('');
}

function openCartDrawer() {
    document.getElementById('cartOverlay').classList.add('open');
}

function closeCartDrawer() {
    document.getElementById('cartOverlay').classList.remove('open');
}

function closeCartOnOverlay(e) {
    if (e.target.id === 'cartOverlay') {
        closeCartDrawer();
    }
}

// Submit Order to Order Microservice
async function submitOrder() {
    if (cart.length === 0) {
        showToast('Please add at least one dish to your order.', 'error');
        return;
    }

    const customerName = document.getElementById('inputCustomerName').value || 'Guest Customer';
    const specialNotes = document.getElementById('inputSpecialNotes').value || '';
    const tableNumber = document.getElementById('inputTableNum').value || 'Table 1';
    const deliveryAddress = document.getElementById('inputAddress').value || '';
    const phone = document.getElementById('inputPhone').value || '';

    const orderPayload = {
        customerName: customerName,
        customerEmail: 'customer@bistrobyte.com',
        channel: selectedChannel,
        tableNumber: selectedChannel === 'DINE_IN' ? tableNumber : null,
        deliveryAddress: selectedChannel === 'DELIVERY' ? deliveryAddress : null,
        customerPhone: phone,
        specialInstructions: specialNotes,
        items: cart.map(item => ({
            menuItemId: item.id,
            itemName: item.name,
            category: item.category,
            price: item.price,
            quantity: item.quantity
        }))
    };

    try {
        const response = await fetch('/api/orders', {
            method: 'POST',
            headers: {
                'Content-Type': 'application/json',
                'Authorization': 'Bearer ' + jwtToken
            },
            body: JSON.stringify(orderPayload)
        });

        const data = await response.json();

        if (response.status === 409 || data.error === 'SOLD_OUT_ERROR') {
            // Inter-service check caught sold-out item!
            showToast(data.message || 'Order rejected: Sold-out item detected!', 'error');
            return;
        }

        if (!response.ok) {
            showToast('Failed to place order: ' + (data.message || data.error || 'Server error'), 'error');
            return;
        }

        // Order placed successfully!
        showToast(`🎉 Order ${data.orderNumber} placed successfully!`, 'success');
        cart = [];
        updateCartUI();
        closeCartDrawer();

        // Switch to Live Tracker tab with this order
        document.getElementById('trackerInput').value = data.orderNumber;
        openTab('trackerTab');
        trackOrder();
        fetchKitchenOrders();

    } catch (e) {
        showToast('Network error while placing order: ' + e.message, 'error');
    }
}

// -------------------------------------------------------------
// TAB 2: KITCHEN EXECUTION SYSTEM (KDS)
// -------------------------------------------------------------
async function fetchKitchenOrders() {
    try {
        const res = await fetch('/api/orders/kitchen/active');
        const orders = await res.json();

        const placedOrders = orders.filter(o => o.status === 'PLACED' || o.status === 'CONFIRMED');
        const prepOrders = orders.filter(o => o.status === 'PREPARING');
        const readyOrders = orders.filter(o => o.status === 'READY_FOR_PICKUP');

        // Update metric counters
        document.getElementById('statPlaced').textContent = placedOrders.length;
        document.getElementById('statPreparing').textContent = prepOrders.length;
        document.getElementById('statReady').textContent = readyOrders.length;
        document.getElementById('statTotalActive').textContent = orders.length;
        document.getElementById('kdsBadge').textContent = orders.length;

        document.getElementById('colPlacedCount').textContent = placedOrders.length;
        document.getElementById('colPrepCount').textContent = prepOrders.length;
        document.getElementById('colReadyCount').textContent = readyOrders.length;

        renderKdsCards('colPlacedCards', placedOrders, 'Start Cooking 🔥', 'PREPARING');
        renderKdsCards('colPrepCards', prepOrders, 'Mark Ready ✅', 'READY_FOR_PICKUP');
        renderKdsCards('colReadyCards', readyOrders, 'Complete / Deliver 🚀', 'COMPLETED');

    } catch (e) {
        console.warn("KDS poll error:", e);
    }
}

function renderKdsCards(containerId, orders, nextActionLabel, nextStatus) {
    const container = document.getElementById(containerId);
    if (!container) return;

    if (orders.length === 0) {
        container.innerHTML = `<p style="font-size: 0.8rem; color: var(--text-dim); text-align: center; padding: 2rem 0;">No orders in this stage.</p>`;
        return;
    }

    container.innerHTML = orders.map(o => {
        const channelLabel = o.channel === 'DINE_IN' ? `🪑 ${o.tableNumber || 'Table'}` :
                             o.channel === 'DELIVERY' ? `🛵 Delivery` : `🥡 Takeaway`;

        const itemsHtml = o.items ? o.items.map(item => `
            <div class="kds-dish-item">
                <span>${item.itemName}</span>
                <span style="color: var(--accent); font-weight: bold;">&times; ${item.quantity}</span>
            </div>
        `).join('') : '';

        return `
            <div class="kds-order-card ${o.status}">
                <div class="kds-card-top">
                    <span class="kds-order-num">${o.orderNumber}</span>
                    <span class="kds-channel-badge">${channelLabel}</span>
                </div>
                <div class="kds-customer-row">
                    👤 ${o.customerName}
                    ${o.specialInstructions ? `<div style="font-size: 0.75rem; color: var(--warning); margin-top: 0.2rem;">Note: ${o.specialInstructions}</div>` : ''}
                </div>
                <div class="kds-items-box">
                    ${itemsHtml}
                </div>
                <div class="kds-card-footer">
                    <span class="kds-time">⏱️ Total: $${o.totalAmount ? o.totalAmount.toFixed(2) : '0.00'}</span>
                    <button class="btn-kds-action" onclick="updateOrderStatus(${o.id}, '${nextStatus}')">
                        ${nextActionLabel}
                    </button>
                </div>
            </div>
        `;
    }).join('');
}

async function updateOrderStatus(orderId, newStatus) {
    try {
        // Direct GET URL for easy testing & compatibility
        const res = await fetch(`/api/orders/update-status-get?orderId=${orderId}&status=${newStatus}`);
        const data = await res.json();
        if (res.ok) {
            showToast(`Order status updated to ${newStatus}`, 'success');
            fetchKitchenOrders();
        } else {
            showToast('Failed to update status: ' + data.error, 'error');
        }
    } catch (e) {
        showToast('Error updating status: ' + e.message, 'error');
    }
}

// -------------------------------------------------------------
// TAB 3: LIVE ORDER TRACKER
// -------------------------------------------------------------
async function trackOrder() {
    const orderNumber = document.getElementById('trackerInput').value.trim();
    if (!orderNumber) {
        showToast('Please enter an Order Number to track.', 'error');
        return;
    }

    try {
        const res = await fetch(`/api/orders/track?orderNumber=${encodeURIComponent(orderNumber)}`);
        if (!res.ok) {
            showToast(`Order ${orderNumber} not found. Try BB-1021 or place a new order!`, 'error');
            return;
        }

        const data = await res.json();
        renderTrackerData(data);

    } catch (e) {
        showToast('Failed to track order: ' + e.message, 'error');
    }
}

function renderTrackerData(data) {
    const step = data.currentStep || 1;
    const progressPercent = Math.min(100, Math.max(10, (step - 1) * 25));

    document.getElementById('stepperProgressBar').style.width = progressPercent + '%';

    for (let i = 1; i <= 5; i++) {
        const node = document.getElementById(`stepNode${i}`);
        if (!node) continue;
        node.classList.remove('active', 'completed');
        if (i < step) {
            node.classList.add('completed');
        } else if (i === step) {
            node.classList.add('active');
        }
    }

    const itemsSummary = data.items ? data.items.map(item => `
        <div style="display: flex; justify-content: space-between; font-size: 0.85rem; padding: 0.3rem 0; border-bottom: 1px solid rgba(255,255,255,0.05);">
            <span>${item.itemName} &times; ${item.quantity}</span>
            <span style="color: var(--accent); font-weight: bold;">$${item.subtotal ? item.subtotal.toFixed(2) : (item.price * item.quantity).toFixed(2)}</span>
        </div>
    `).join('') : '';

    const channelDetails = data.channel === 'DINE_IN' ? `Table: ${data.tableNumber || 'N/A'}` :
                          data.channel === 'DELIVERY' ? `Delivery to: ${data.deliveryAddress || 'N/A'}` :
                          `Takeaway Pickup`;

    document.getElementById('trackerDetailsCard').innerHTML = `
        <div style="display: flex; justify-content: space-between; align-items: center; border-bottom: 1px solid var(--border); padding-bottom: 0.75rem;">
            <div>
                <h3 style="font-family: var(--font-heading); font-size: 1.3rem;">Order #${data.orderNumber}</h3>
                <span style="font-size: 0.8rem; color: var(--text-muted);">${channelDetails} | Guest: ${data.customerName}</span>
            </div>
            <span class="kds-channel-badge" style="font-size: 0.85rem; background: var(--bg-card); color: var(--primary);">
                STATUS: ${data.status}
            </span>
        </div>

        <div style="display: flex; gap: 2rem; margin: 0.5rem 0; font-size: 0.85rem;">
            <div>⏱️ Estimated Prep Time: <strong>${data.estimatedPrepMinutes || 20} mins</strong></div>
            <div>💰 Total: <strong>$${data.totalAmount ? data.totalAmount.toFixed(2) : '0.00'}</strong></div>
        </div>

        <div>
            <h4 style="font-size: 0.85rem; text-transform: uppercase; color: var(--text-muted); margin-bottom: 0.4rem;">Order Items:</h4>
            ${itemsSummary}
        </div>
    `;
}

